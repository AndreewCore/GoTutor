# Copia este archivo como .env.local y completa con la config web de tu proyecto
# de Firebase (Consola de Firebase → Configuración del proyecto → Tus apps).
# Mientras estén vacías, GoTutor usa el modo invitado con localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
